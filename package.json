  },
  "homepage": "https://github.com/JMartynov/mongo-schema-fetch#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "mongodb": "^7.2.0",
    "mongodb-schema": "^12.7.0",
    "open": "^11.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@testcontainers/mongodb": "^12.0.1",
